{
  "id": "./",
  "name": "Voxelify",
  "short_name": "Voxelify",
  "description": "Music player without ads. Your files, 11 languages, works offline.",
  "lang": "en",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a1222",
  "theme_color": "#2563eb",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/player.png",
      "sizes": "780x1560",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Player"
    },
    {
      "src": "screenshots/settings.png",
      "sizes": "780x1560",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Settings"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/mp4",
            "video/webm",
            ".mp3",
            ".m4a",
            ".flac",
            ".ogg",
            ".opus",
            ".wav",
            ".aac",
            ".webm",
            ".mp4"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/ogg": [
          ".ogg",
          ".opus"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/aac": [
          ".aac"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}